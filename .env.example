# Copy to .env.local (ignored by git) and set your values.
# EXPO_PUBLIC_ values are built into the app bundle, so never put secrets here.

# BookMack backend base URL, no trailing slash. Replace BOTH parts of the example:
# - Host: on a physical phone, "localhost" means the phone itself, so use your computer's
#   LAN IP (macOS: `ipconfig getifaddr en0`) or the deployed backend URL.
# - Port: the PORT from backend/.env (5000 if it isn't set).
EXPO_PUBLIC_API_URL=http://YOUR-COMPUTER-IP:5000
